# ==============================================================
# PocketPulse Ethiopia - Environment Configuration Example
# ==============================================================
# Copy this file to .env and configure for your production deployment.
# NEVER commit your actual .env file or production secrets to Git.

# Server Port
PORT=5001

# Application Environment (development | production | test)
NODE_ENV=development

# Server Session & Cookie Secret
# Replace with a cryptographically random 64-character secret string
SESSION_SECRET=your_strong_random_secret_here_min_32_characters

# Base API URL (defaults to relative /api when proxied by Vite in development)
VITE_API_URL=/api

# Default Application Currency (Default: ETB)
VITE_DEFAULT_CURRENCY=ETB

# Default Application Language (am: Amharic | en: English)
VITE_DEFAULT_LANG=am

# --------------------------------------------------------------
# Optional External Authentication Provider Integration (e.g., Supabase / Firebase / Auth0)
# The built-in secure Node.js + SQLite authentication engine is active by default.
# If connecting an external OAuth / OIDC provider in the future, configure below:
# --------------------------------------------------------------
# AUTH_PROVIDER=builtin # Options: builtin | supabase | firebase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key_placeholder
# FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
